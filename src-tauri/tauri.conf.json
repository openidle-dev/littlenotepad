{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LittleNotepad",
  "version": "0.0.1",
  "identifier": "com.littlenotepad.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LittleNotepad",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1MTU1RTg4MzExQjM2MzkKUldRNU5oc3hpRjRWZGNsYVVVdFRGMXdPYTB6bXI3UHhETVoxVTNxVUZMbE8vVXRLUXdVZENpM2kK",
      "endpoints": [
        "https://github.com/openidle-dev/littlenotepad/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
